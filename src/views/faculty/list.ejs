<%- include('../partials/header') %>

<h1>Faculty Directory</h1>

<div class="sort-options">
  <span>Sort by:</span>
  <a href="/faculty?sort=name">Name</a>
  <a href="/faculty?sort=department">Department</a>
</div>

<div class="faculty-list">
  <% faculty.forEach(f => { %>
    <div class="faculty-card">
      <h3><a href="/faculty/<%= f.slug %>"><%= f.name %></a></h3>
      <p><%= f.title %></p>
      <p><%= f.department %></p>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
