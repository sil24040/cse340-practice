<%- include('../partials/header') %>

<h1><%= course.name %></h1>
<p><%= course.courseCode %> • <%= course.creditHours %> credits</p>
<p><%= course.department %></p>

<h2>Sections</h2>

<div class="sort-options">
  <span>Sort by:</span>
  <a href="/catalog/<%= course.slug %>?sort=time">Time</a>
  <a href="/catalog/<%= course.slug %>?sort=professor">Professor</a>
  <a href="/catalog/<%= course.slug %>?sort=room">Room</a>
</div>

<div class="section-list">
  <% if (course.sections.length === 0) { %>
    <p>No sections available.</p>
  <% } else { %>
    <% course.sections.forEach(section => { %>
      <div class="section-card">
        <p><strong>Time:</strong> <%= section.time %></p>
        <p><strong>Room:</strong> <%= section.room %></p>
        <p><strong>Professor:</strong> <%= section.professor %></p>
      </div>
    <% }) %>
  <% } %>
</div>

<p><a href="/catalog">← Back to Catalog</a></p>

<%- include('../partials/footer') %>
